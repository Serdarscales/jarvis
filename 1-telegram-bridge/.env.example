# Claude Code Telegram Bridge Configuration
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------

# Telegram Bot Token (create a bot with @BotFather, it gives you this)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Comma-separated Telegram user IDs allowed to use the bot.
# Get your ID by messaging @userinfobot on Telegram.
# SECURITY: only put YOUR id here. Anyone on this list can run
# arbitrary commands on your Mac through Claude.
ALLOWED_USER_IDS=123456789

# Telegram group ID (restricts the bot to this one group, recommended).
# Leave empty for the first start, send /id in your group to see the ID
# (it is negative, like -1001234567890), then fill it in and restart.
TELEGRAM_GROUP_ID=

# ------------------------------------------------------------------
# VOICE TRANSCRIPTION (optional)
# ------------------------------------------------------------------

# "local" (mlx-whisper, Apple Silicon only, free, no API key),
# "openai", "groq", or empty to disable voice messages.
WHISPER_PROVIDER=local

# Only needed for openai/groq providers (not for local)
WHISPER_API_KEY=

# Local whisper model (only for local provider).
# Options: mlx-community/whisper-tiny, whisper-base-mlx, whisper-small-mlx,
# whisper-medium-mlx, whisper-large-v3-mlx. Small is a good balance.
WHISPER_MODEL=mlx-community/whisper-small-mlx

# Unload the local Whisper model after N idle minutes (frees ~2.4 GB of
# GPU memory). Set 0 to keep it loaded forever.
WHISPER_IDLE_UNLOAD_MIN=15

# ------------------------------------------------------------------
# CLAUDE
# ------------------------------------------------------------------

# Working directory for Claude Code sessions (your projects folder).
# Claude starts every conversation here and picks up this folder's
# CLAUDE.md. Defaults to your home directory if empty.
WORKING_DIR=

# Claude model override. Empty = your Claude Code default model.
# "opus" always tracks the newest Opus tier. Add the [1m] suffix to get
# the 1M-token context window on plans that support it, e.g. opus[1m]
# (without the suffix every model runs with a 200K window).
# If you plan to add Jarvis (part 2 of this kit), use opus[1m].
CLAUDE_MODEL=opus

# Fallback models, tried in order when your model hits a usage cap or runs
# out of credits (the bridge switches, posts a one-line notice once, and
# switches back when the cap resets). Comma-separated. When not set:
# sonnet[1m] for a [1m] model, else sonnet.
#CLAUDE_MODEL_FALLBACKS=sonnet[1m]

# Reasoning effort for every bridge session: low, medium, high, xhigh or max.
# Default high. Pinning it here keeps the bridge steady even when you change
# the effort in the Claude desktop app or an IDE. "default" = follow your
# global Claude Code setting instead.
#BRIDGE_EFFORT=high

# Per-topic overrides, as comma-separated topic:value pairs. The topic is the
# numeric topic id (send /id inside the topic to see it) or "general".
#TOPIC_MODELS=123:sonnet,456:opus[1m]
#TOPIC_MODEL_FALLBACKS=123:haiku|sonnet
#TOPIC_EFFORTS=123:max

# Timeout in seconds for scheduled/injected trigger prompts (default 300)
CLAUDE_TIMEOUT=300

# Idle timeout for your typed messages: kill the Claude subprocess if it
# produces NO output for this many seconds (default 900 = 15 min).
# Total runtime is unbounded; long tasks are fine as long as they keep
# streaming.
CLAUDE_IDLE_TIMEOUT=900

# Extended idle timeout while a background subagent is running (default 3600)
TASK_IDLE_TIMEOUT=3600

# ------------------------------------------------------------------
# OPTIONAL TUNING (defaults are fine)
# ------------------------------------------------------------------

# Hour of day (0-23, Mac local time) for the daily fresh-memory restart
#BRIDGE_DAILY_RESTART_HOUR=4

# Show live tool-activity progress in the "Thinking..." message (1=on)
#BRIDGE_SHOW_PROGRESS=1

# Where uploaded photos/files land before Claude reads them
#UPLOAD_DIR=/private/tmp/claude-telegram-uploads

# Auto-delete uploads older than this many hours (0 = never delete)
#UPLOAD_RETENTION_HOURS=48

# Force a specific IANA timezone for time injection (default: Mac's zone)
#USER_TIMEZONE=Europe/Vienna

# Long-lived automation token file (mint with `claude setup-token`)
#CLAUDE_AUTOMATION_TOKEN_FILE=~/.config/claude/automation-oauth-token.txt
