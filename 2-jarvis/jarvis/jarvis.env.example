# Jarvis configuration. Copy to ~/.claude/jarvis/jarvis.env and fill in.
# Read by every Jarvis script and by the patched bridge. The Telegram bot token
# and group id are NOT here: Jarvis reads them live from the bridge's .env.

# ------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------

# Your first name. Jarvis talks to you by name and the persona is written around it.
JARVIS_OWNER=YourName

# The Telegram topic that IS Jarvis. Create it in your bridge group with
# /topic Jarvis, open it, send /id, and copy the "Topic ID" number here.
# Restart the bridge after changing it.
JARVIS_TOPIC_ID=

# Absolute path to the claude CLI (output of: command -v claude).
# Needed because the scheduled jobs run with a minimal PATH.
CLAUDE_BIN=

# Folder where Jarvis's workers start (normally the same as the bridge's
# WORKING_DIR): your projects folder with your CLAUDE.md. Default: your home.
JARVIS_WORKSPACE=

# ------------------------------------------------------------------
# VOICE (what Jarvis sounds like)
# ------------------------------------------------------------------

# elevenlabs (best, needs a key) | openai (good, needs a key) | say (free macOS voice)
# Any engine falls back to macOS say automatically if the API fails.
JARVIS_TTS=say

# ElevenLabs: API key from elevenlabs.io > Profile > API Keys.
# Voice id: elevenlabs.io > Voices > pick or clone a voice > copy its Voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# OpenAI TTS (only if JARVIS_TTS=openai): key from platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx

# macOS say voice (only if JARVIS_TTS=say). List voices with: say -v '?'
JARVIS_SAY_VOICE=

# ------------------------------------------------------------------
# MODEL + LIMITS (the defaults are the recommended values)
# ------------------------------------------------------------------

# Model for workers, threads and the nightly journal. opus[1m] = newest Opus
# with the 1M-token window; use plain "opus" if your plan has no 1M window.
JARVIS_MODEL=opus[1m]

# Thread worker effort: low | medium | high | xhigh | max
JARVIS_THREAD_EFFORT=high

# Max thread turns running at the same time
#JARVIS_RUN_CAP=8

# A self-driving thread pauses to check in with you every N turns
#JARVIS_CHECKIN_TURNS=15

# One-shot worker hard timeout in seconds (default 2 hours)
#JARVIS_WORKER_TIMEOUT=7200

# Jarvis conversation size (tokens) that triggers a mid-day journal + reset.
# The default 500000 only works when the Jarvis topic runs a 1M-window model
# (bridge CLAUDE_MODEL=opus[1m], or TOPIC_MODELS=<jarvis topic id>:opus[1m]).
# On a 200K-window model set ~150000, or the reset never fires.
#JARVIS_CTX_THRESHOLD=500000

# Where the bridge lives (default ~/.claude/telegram-bridge)
#BRIDGE_DIR=
