<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.claude/jarvis/cron/jarvis-watch</string>
  </array>
  <key>StartInterval</key><integer>1200</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__CLAUDE_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.claude/jarvis/state/cron-watch.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/jarvis/state/cron-watch.err</string>
</dict>
</plist>
