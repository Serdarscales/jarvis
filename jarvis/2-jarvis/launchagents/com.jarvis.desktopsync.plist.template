<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.desktopsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-c</string>
    <string>import subprocess, sys; sys.exit(subprocess.run(['/bin/bash', *sys.argv[1:]]).returncode)</string>
    <string>__HOME__/.claude/jarvis/cron/jarvis-desktop-sync</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__CLAUDE_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.claude/jarvis/state/cron-desktopsync.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/jarvis/state/cron-desktopsync.err</string>
</dict>
</plist>
